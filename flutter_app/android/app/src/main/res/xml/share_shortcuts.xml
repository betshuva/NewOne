<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="new_chat" android:enabled="true"
        android:icon="@drawable/shortcut_chat"
        android:shortcutShortLabel="@string/shortcut_new_chat"
        android:shortcutLongLabel="@string/shortcut_new_chat">
        <intent android:action="com.betshuva.app.OPEN_ACTION"
            android:targetPackage="com.betshuva.app" android:targetClass="com.betshuva.app.MainActivity">
            <extra android:name="betshuva_action" android:value="newchat"/>
        </intent>
    </shortcut>
    <shortcut android:shortcutId="capture_send" android:enabled="true"
        android:icon="@drawable/shortcut_camera"
        android:shortcutShortLabel="@string/shortcut_capture_send"
        android:shortcutLongLabel="@string/shortcut_capture_send">
        <intent android:action="com.betshuva.app.OPEN_ACTION"
            android:targetPackage="com.betshuva.app" android:targetClass="com.betshuva.app.MainActivity">
            <extra android:name="betshuva_action" android:value="capture"/>
        </intent>
    </shortcut>
    <shortcut android:shortcutId="new_listing" android:enabled="true"
        android:icon="@drawable/shortcut_listing"
        android:shortcutShortLabel="@string/shortcut_new_listing"
        android:shortcutLongLabel="@string/shortcut_new_listing">
        <intent android:action="com.betshuva.app.OPEN_ACTION"
            android:targetPackage="com.betshuva.app" android:targetClass="com.betshuva.app.MainActivity">
            <extra android:name="betshuva_action" android:value="newlisting"/>
        </intent>
    </shortcut>
    <share-target android:targetClass="com.betshuva.app.MainActivity">
        <data android:mimeType="*/*"/>
        <category android:name="com.betshuva.app.CONVERSATION"/>
    </share-target>
</shortcuts>
